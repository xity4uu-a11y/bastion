# Bastion v2.1.0 Environment Configuration
# Copy to .env (never commit real API keys).
# Environment variables ALWAYS take precedence over encrypted local vault entries (~/.bastion/keys/vault.key).

# Gate 1 Pluggable Secret Scanner: auto | gitleaks | trufflehog
BASTION_DEFAULT_SECRET_SCANNER=auto

# Gate 2 BYOK Multi-Agent LLM Provider: none | gemini | anthropic | openai | ollama
# When set to "none" (or no key configured), Gate 2 runs in "Static Heuristic Fallback (No LLM)" mode.
BASTION_LLM_PROVIDER=none
BASTION_LLM_MODEL=

# Standard Provider Environment Variables (CI/CD & local env precedence over SQLite encrypted vault)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Gate 2 Scoping & Token/Cost Budgeting
BASTION_DEFAULT_AUDIT_SCOPE=diff
BASTION_DEFAULT_MAX_BUDGET_USD=1.50
BASTION_DEFAULT_MAX_INPUT_TOKENS=120000

# Gate 3 Post-BLA Smoke Test Timeout (seconds)
BASTION_SMOKE_TEST_TIMEOUT_SECONDS=30

# Asymmetric Ed25519 Signing Key & Fernet Vault Master Key Directory (stored securely outside target repos)
# Default: ~/.bastion/keys
# BASTION_KEYS_DIR=
BASTION_CERTIFICATE_TTL_DAYS=30
